{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/vitest",
    "ultracite/biome/react",
    "ultracite/biome/astro"
  ],
  "files": {
    "includes": [
      "!dist",
      "!coverage",
      "!CHANGELOG.md",
      "!templates/starlight/package-lock.json"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        // Key order is part of the output for generated files (manifests, stamped docs).
        "useSortedKeys": "off",
        "useSortedInterfaceMembers": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["camelCase", "PascalCase", "kebab-case"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "suspicious": { "noUnknownAttribute": "off" }
        }
      }
    },
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "performance": { "useTopLevelRegex": "off" }
        }
      }
    },
    {
      // The site template is copied into user projects, where their own lint setup applies.
      "includes": ["templates/**"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" },
          "performance": {
            "noBarrelFile": "off",
            "noJsxPropsBind": "off"
          },
          "style": {
            "noDescendingSpecificity": "off",
            "noExportedImports": "off",
            "noNestedTernary": "off"
          }
        }
      }
    }
  ]
}
